<Window x:Class="VioletSoundpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Violet Soundpad" Icon="app.ico" Width="1170" Height="740" MinWidth="970" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" Language="ru-RU"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        PreviewDragOver="OnDragOver" Drop="OnDrop" Loaded="OnLoaded" SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Selected}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ListRow}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="SmallIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent" LastChildFill="True">
                            <Border x:Name="Box" Width="16" Height="16" Margin="0,0,8,0" CornerRadius="4"
                                    VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource Muted}">
                                <Path x:Name="Mark" Data="M 0,3 L 3,6 L 8,0" StrokeThickness="1.5" Stroke="{StaticResource Ink}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentFill}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentFill}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DeviceName">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="12"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="79"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="306"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <Grid Margin="17,22,17,19">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="3,0,0,29">
                    <Border Width="39" Height="39" CornerRadius="11" Background="{StaticResource AccentFill}">
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="2.2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0,7 L 0,12 M 5,3 L 5,16 M 10,0 L 10,19 M 15,4 L 15,15 M 20,7 L 20,12"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Violet" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="SOUNDPAD" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="БИБЛИОТЕКА" Style="{StaticResource Label}" Margin="9,0,0,8"/>
                    <ListBox x:Name="LibraryList" Style="{StaticResource CleanList}" SelectionChanged="OnLibrarySelection">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource SmallIcon}" Margin="0,0,9,0"/>
                                <TextBlock Text="Все звуки"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
                <DockPanel Grid.Row="2" Margin="9,21,0,5" LastChildFill="True">
                    <Button x:Name="NewFolderButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Width="28"
                            Click="OnAddFolder" ToolTip="Новая папка" AutomationProperties.Name="Новая папка">
                        <TextBlock Text="&#xE710;" Style="{StaticResource SmallIcon}"/>
                    </Button>
                    <TextBlock Text="ПАПКИ" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="3">
                    <TextBlock x:Name="FolderEmpty" Text="Пока нет папок" Foreground="{StaticResource Muted}" FontSize="12" Margin="9,9,0,0"/>
                    <ListBox x:Name="FolderList" Style="{StaticResource CleanList}" SelectionChanged="OnFolderSelection">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource SmallIcon}" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Name}" MaxWidth="127" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Border Grid.Row="4" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="8,13,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RouteDot" Width="7" Height="7" Fill="{StaticResource Warning}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RouteStatus" Text="Кабель не найден" Margin="8,0,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="25,26,25,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FolderMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="OnFolderMenu"
                            Visibility="Collapsed" ToolTip="Действия с папкой" AutomationProperties.Name="Действия с папкой" Margin="0,0,8,0"/>
                    <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Height="38" Click="OnAddFiles"
                            AutomationProperties.Name="Добавить звуки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Ink}" Margin="0,1,7,0"/>
                            <TextBlock Text="Добавить звуки" Foreground="{StaticResource Ink}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock x:Name="LibraryTitle" Text="Все звуки" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ClipCount" Text="0 звуков" Foreground="{StaticResource Muted}" Margin="1,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid x:Name="TableHeader" Grid.Row="1" Margin="11,27,10,7" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="НАЗВАНИЕ" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="2" Text="ФОРМАТ" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="3" Text="ВРЕМЯ" Style="{StaticResource Label}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <ListBox x:Name="ClipList" Style="{StaticResource CleanList}" MouseDoubleClick="OnDoubleClickClip"
                         KeyDown="OnClipKey" SelectionChanged="OnClipSelection">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE768;"
                                        HorizontalAlignment="Left" Width="30" Height="30" MinHeight="30"
                                        Click="OnRowPlay" ToolTip="Воспроизвести" AutomationProperties.Name="Воспроизвести клип"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Format}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Length}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE712;" Width="30" Height="30" MinHeight="30"
                                        Click="OnClipMenu" ToolTip="Действия с клипом" AutomationProperties.Name="Действия с клипом"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="EmptyLibrary" CornerRadius="14" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        Margin="0,8,0,8" Background="{StaticResource Sidebar}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                        <Border Width="67" Height="67" CornerRadius="18" HorizontalAlignment="Center" Background="{StaticResource Selected}">
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,12 L 0,20 M 7,7 L 7,25 M 14,0 L 14,32 M 21,5 L 21,27 M 28,12 L 28,20"/>
                        </Border>
                        <TextBlock Text="Здесь будут ваши звуки" Margin="0,17,0,0" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Перетащите аудиофайлы сюда или выберите их на диске." Margin="0,7,0,15"
                                   Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="EmptyImportButton" HorizontalAlignment="Center" Content="Выбрать файлы" Click="OnAddFiles"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="Готово" Foreground="{StaticResource Muted}" Margin="1,6,0,0"
                       FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="17,25,17,17">
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRefreshDevices"
                                ToolTip="Обновить устройства" AutomationProperties.Name="Обновить устройства"/>
                        <TextBlock Text="Аудиоустройства" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <TextBlock Text="&#xE720;" Style="{StaticResource SmallIcon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Виртуальный микрофон" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="Вход виртуального кабеля" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CableCombo" ItemTemplate="{StaticResource DeviceName}" SelectionChanged="OnDeviceSelection"
                                      AutomationProperties.Name="Вход виртуального кабеля"/>
                            <StackPanel x:Name="CableHelp" Margin="0,7,0,0">
                                <TextBlock Text="Установите VB-CABLE и обновите список устройств."
                                           Foreground="{StaticResource Warning}" FontSize="12" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource LinkButton}" Content="Сайт VB-CABLE" Click="OnCableHelp" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Text="Куда воспроизводить" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <ComboBox x:Name="RouteCombo" SelectionChanged="OnDeviceSelection" AutomationProperties.Name="Куда воспроизводить">
                                <ComboBoxItem Content="Только в микрофон"/>
                                <ComboBoxItem Content="В микрофон и наушники"/>
                            </ComboBox>
                            <StackPanel x:Name="MonitorPanel" Visibility="Collapsed">
                                <TextBlock Text="Наушники" Style="{StaticResource Label}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="MonitorCombo" ItemTemplate="{StaticResource DeviceName}" SelectionChanged="OnDeviceSelection"
                                          AutomationProperties.Name="Наушники"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <TextBlock Text="&#xE720;" Style="{StaticResource SmallIcon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Физический микрофон" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <ComboBox x:Name="MicrophoneCombo" ItemTemplate="{StaticResource DeviceName}" SelectionChanged="OnDeviceSelection"
                                      AutomationProperties.Name="Физический микрофон"/>
                            <Grid Margin="0,11,0,8">
                                <TextBlock Text="Уровень сигнала" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="MicLevelText" Text="—" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </Grid>
                            <ProgressBar x:Name="MicLevel" Maximum="1" Height="6" AutomationProperties.Name="Уровень сигнала"/>
                            <Button x:Name="MicTestButton" Content="Проверить микрофон" Click="OnMicTest" Margin="0,12,0,0"/>
                            <CheckBox x:Name="VoiceCheck" Style="{StaticResource Check}" Margin="0,13,0,0"
                                      Content="Передавать мой голос" Checked="OnVoiceChanged" Unchecked="OnVoiceChanged"
                                      ToolTip="Добавить голос с физического микрофона к клипам в виртуальном микрофоне"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0" Padding="19,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="235"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="39" Height="39" CornerRadius="10" Background="{StaticResource Selected}" Margin="0,0,10,0">
                        <TextBlock Text="&#xEC4F;" Style="{StaticResource SmallIcon}" HorizontalAlignment="Center" FontSize="17"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="165">
                        <TextBlock x:Name="NowPlaying" Text="Клип не выбран" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="PlayState" Text="Остановлено" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,13,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}" Width="55" Height="32" MinHeight="32"
                                Padding="0" Click="OnPlayPause" ToolTip="Воспроизвести" AutomationProperties.Name="Воспроизвести">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Ink}" FontSize="15"/>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Height="32" MinHeight="32"
                                Click="OnStop" ToolTip="Остановить" AutomationProperties.Name="Остановить" Margin="7,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="41"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="41"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Elapsed" Text="0:00" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <ProgressBar x:Name="PlaybackProgress" Grid.Column="1" Maximum="1" VerticalAlignment="Center"
                                     AutomationProperties.Name="Прогресс воспроизведения"/>
                        <TextBlock x:Name="Total" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="2" Width="201" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE767;" Style="{StaticResource SmallIcon}" ToolTip="Громкость клипов"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Height="23" Value="80" IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10" ValueChanged="OnVolumeChanged" AutomationProperties.Name="Громкость клипов"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="80 %" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
